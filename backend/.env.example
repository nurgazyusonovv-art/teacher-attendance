# Environment Mode
PROJECT_NAME="Teacher Attendance API"
ENVIRONMENT="development"
DEBUG=True

# Security
# Generate a unique value for every deployed environment. Never commit the real value.
SECRET_KEY="replace-with-a-random-secret-at-least-32-characters"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
ATTENDANCE_RATE_LIMIT_PER_MINUTE=10
ALGORITHM="HS256"

# Optional one-time bootstrap. Keep disabled in normal runtime.
ALLOW_BOOTSTRAP_SEED=false
# SEED_ADMIN_PASSWORD="generate-a-unique-password"
# SEED_TEACHER_PASSWORD="generate-a-unique-password"
# SEED_DEMO_PASSWORD="generate-a-unique-password"

# Database
# Use postgresql+asyncpg:// for async or sqlite+aiosqlite:// for testing/local
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=teacher_attendance
DATABASE_URL="postgresql+asyncpg://postgres:replace-me@localhost:5432/teacher_attendance"
# Synchronous DB URL for Alembic migrations
SYNC_DATABASE_URL="postgresql://postgres:replace-me@localhost:5432/teacher_attendance"
DB_SSL_REQUIRE=false

# Timezone (Default for school)
TIMEZONE="Asia/Bishkek"

# Geofence defaults
DEFAULT_ALLOWED_RADIUS_METERS=80.0
DEFAULT_MAX_GPS_ACCURACY_METERS=50.0

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://localhost:5000"]
