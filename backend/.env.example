# Environment Mode
PROJECT_NAME="Teacher Attendance API"
ENVIRONMENT="development"
DEBUG=True

# Security
SECRET_KEY="super-secret-key-change-in-production-min-32-chars"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
ALGORITHM="HS256"

# Database
# Use postgresql+asyncpg:// for async or sqlite+aiosqlite:// for testing/local
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=teacher_attendance
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/teacher_attendance"
# Synchronous DB URL for Alembic migrations
SYNC_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/teacher_attendance"

# Timezone (Default for school)
TIMEZONE="Asia/Bishkek"

# Geofence defaults
DEFAULT_ALLOWED_RADIUS_METERS=80.0
DEFAULT_MAX_GPS_ACCURACY_METERS=50.0

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://localhost:5000"]
